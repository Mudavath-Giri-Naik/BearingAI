FROM node:22-alpine
WORKDIR /app
COPY frontend/package*.json ./
RUN npm install --no-audit --no-fund
COPY frontend ./
ARG NEXT_PUBLIC_SUPABASE_URL=
ARG NEXT_PUBLIC_SUPABASE_ANON_KEY=
ARG NEXT_PUBLIC_BEARING_AUTH_MODE=local
ENV NEXT_PUBLIC_SUPABASE_URL=$NEXT_PUBLIC_SUPABASE_URL NEXT_PUBLIC_SUPABASE_ANON_KEY=$NEXT_PUBLIC_SUPABASE_ANON_KEY NEXT_PUBLIC_BEARING_AUTH_MODE=$NEXT_PUBLIC_BEARING_AUTH_MODE
RUN npm run build
EXPOSE 3000
CMD ["npm","run","start"]
