# Local development secrets. Copy to .env and replace every value before starting.
BEARING_ADMIN_KEY=CHANGE_ME_TO_A_LONG_RANDOM_32_CHAR_API_KEY
STUDIO_PASSWORD=CHANGE_ME_TO_A_LONG_PRIVATE_DEVELOPER_PASSWORD
SESSION_SECRET=CHANGE_ME_TO_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS

# Supabase production configuration. Keep service role credentials server-side only.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=SET_ONLY_ON_RENDER_BACKEND_AND_WORKER
SUPABASE_DB_URL=postgresql://postgres:YOUR_PASSWORD@YOUR_HOST:5432/postgres
SUPABASE_DATASETS_BUCKET=bearing-datasets
SUPABASE_MODELS_BUCKET=bearing-model-artifacts

# Production authentication. Set this in Vercel and Render as appropriate.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY
NEXT_PUBLIC_BEARING_AUTH_MODE=local
API_INTERNAL_URL=http://localhost:9000
BEARING_STORAGE=../storage
BEARING_AUTH_MODE=local
